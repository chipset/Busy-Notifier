{
  "manifest_version": 3,
  "name": "Meeting Busy — background meeting detection",
  "version": "0.0.3",
  "description": "Reports meeting and screen-sharing state from supported meeting tabs to the local Meeting Busy app.",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://*.webex.com/*",
    "https://webex.com/*",
    "https://*.zoom.us/*",
    "https://zoom.us/*",
    "https://*.zoom.com/*",
    "https://zoom.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.webex.com/*",
        "https://webex.com/*",
        "https://*.zoom.us/*",
        "https://zoom.us/*",
        "https://*.zoom.com/*",
        "https://zoom.com/*"
      ],
      "js": [
        "detector.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Meeting Busy",
    "default_popup": "popup.html"
  },
  "key": "",
  "minimum_chrome_version": "109",
  "background": {
    "service_worker": "background.js"
  }
}
